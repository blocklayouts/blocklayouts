# Files and folders that are not deployed to WordPress.org.
# Used by .github/workflows/deploy.yml (rsync exclude patterns, one per line).

/.git
/.github
/.wordpress-org
/node_modules
/src
/.distignore
/.editorconfig
/.gitattributes
/.gitignore
/package.json
/package-lock.json
/README.md
*.map
*.zip
