{
	"name": "blocklayouts",
	"version": "0.2.1",
	"description": "Pre-Designed WordPress Patterns Library.",
	"author": "Qara Yahya",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"files": [
		"blocklayouts.php",
		"uninstall.php",
		"readme.txt",
		"assets",
		"build",
		"inc",
		"languages"
	],
	"scripts": {
		"build": "wp-scripts build --experimental-modules",
		"build:dashboard": "wp-scripts build src/dashboard/index.js --output-path=build/dashboard/",
		"start": "wp-scripts start --experimental-modules",
		"start:dashboard": "wp-scripts start src/dashboard/index.js --output-path=build/dashboard",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip"
	},
	"devDependencies": {
		"@wordpress/base-styles": "^6.13.0",
		"@wordpress/scripts": "^30.17.0"
	},
	"dependencies": {
		"@masonry-grid/vanilla": "^1.1.0",
		"@wordpress/dataviews": "^4.22.0",
		"@wordpress/icons": "^10.24.0",
		"@wordpress/interactivity": "^6.34.0",
		"@wordpress/ui": "^0.3.0",
		"classnames": "^2.5.1",
		"clipboard": "^2.0.11",
		"clsx": "^2.1.1",
		"minimasonry": "^1.3.2"
	}
}
